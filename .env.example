# ============================================================
# HMIS WhatsApp Bot — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to Git.
# ============================================================

# ------ WhatsApp Cloud API (Meta) ------
# All four come from https://developers.facebook.com/ → your App → WhatsApp.

# Permanent System User access token. Required scopes:
#   whatsapp_business_messaging  +  whatsapp_business_management
WHATSAPP_ACCESS_TOKEN=your-meta-permanent-access-token-here

# Numeric ID of the phone number registered to your WhatsApp Business Account.
# Find it under WhatsApp → API Setup → "From" phone number.
WHATSAPP_PHONE_NUMBER_ID=000000000000000

# Any random string YOU pick — Meta uses it to verify your webhook URL
# during setup. Must match exactly what you enter in Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=pick-any-random-string-here

# App Secret — used to validate that incoming webhooks were actually sent
# by Meta (HMAC-SHA256 signature on the request body). STRONGLY recommended
# in production. Find it under App Settings → Basic → App Secret.
WHATSAPP_APP_SECRET=your-meta-app-secret-here

# Graph API version — bump when Meta releases a newer one (default: v22.0).
WHATSAPP_GRAPH_VERSION=v22.0

# ------ Web server ------
# 0.0.0.0 binds on all interfaces; needed so Meta's webhook can reach the bot.
# Override the port if your reverse proxy or firewall expects something else.
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ------ OpenAI ------
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
AI_MODEL_SQL=gpt-5.4
AI_MODEL_FAST=gpt-5.4-mini

# ------ Google BigQuery ------
# Path to your service account JSON file (relative or absolute).
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
BIGQUERY_PROJECT_ID=biharhmisdatafordvctool

# ------ Conversation settings ------
MAX_HISTORY_EXCHANGES=10

# ------ Audit logging ------
# Google Sheet ID for the audit log (the part of the URL between /d/ and /edit).
# Leave blank on first run — the bot will create a sheet and print its ID.
AUDIT_SHEET_ID=
